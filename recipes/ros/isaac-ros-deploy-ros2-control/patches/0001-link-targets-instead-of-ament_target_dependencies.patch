From: Isaac Forge <noreply@example.com>
Subject: [PATCH] Link targets instead of ament_target_dependencies()

ament_target_dependencies() was removed from ament_cmake in 2.8.6 (ament/ament_cmake#614),
so this no longer configures on ROS 2 Lyrical. Link each dependency's exported
${<pkg>_TARGETS} instead, as nvblox_ros already does. Plain signature, matching the
other target_link_libraries() calls on these targets.
---
--- a/isaac_deploy/isaac_ros_deploy_ros2_control/CMakeLists.txt
+++ b/isaac_deploy/isaac_ros_deploy_ros2_control/CMakeLists.txt
@@ -155,10 +155,9 @@
   $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
   $<INSTALL_INTERFACE:include>
 )
-ament_target_dependencies(tensor_interface_utils
-  hardware_interface
-)
 target_link_libraries(tensor_interface_utils
+  ${hardware_interface_TARGETS})
+target_link_libraries(tensor_interface_utils
   isaac_deploy_core::types
   isaac_deploy_core::tensor_utils
   ${TORCH_LIBRARIES}
@@ -200,21 +199,20 @@
   $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
   $<INSTALL_INTERFACE:include>
 )
-ament_target_dependencies(isaac_ros_deploy_ros2_control_controllers
-  controller_manager_msgs
-  controller_interface
-  hardware_interface
-  pluginlib
-  rcl_interfaces
-  rclcpp
-  rclcpp_lifecycle
-  realtime_tools
-  sensor_msgs
-  std_msgs
-  urdf
-  isaac_ros_deploy_interfaces
-  isaac_ros_deploy_converters
-)
+target_link_libraries(isaac_ros_deploy_ros2_control_controllers
+  ${controller_manager_msgs_TARGETS}
+  ${controller_interface_TARGETS}
+  ${hardware_interface_TARGETS}
+  ${pluginlib_TARGETS}
+  ${rcl_interfaces_TARGETS}
+  ${rclcpp_TARGETS}
+  ${rclcpp_lifecycle_TARGETS}
+  ${realtime_tools_TARGETS}
+  ${sensor_msgs_TARGETS}
+  ${std_msgs_TARGETS}
+  ${urdf_TARGETS}
+  ${isaac_ros_deploy_interfaces_TARGETS}
+  ${isaac_ros_deploy_converters_TARGETS})
 target_link_libraries(isaac_ros_deploy_ros2_control_controllers
   leapp_backend_mapping
   tensor_interface_utils
@@ -243,15 +241,14 @@
   $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
   $<INSTALL_INTERFACE:include>
 )
-ament_target_dependencies(isaac_ros_deploy_ros2_control_hardware
-  hardware_interface
-  pluginlib
-  rclcpp
-  rclcpp_lifecycle
-  realtime_tools
-  std_msgs
-  sensor_msgs
-)
+target_link_libraries(isaac_ros_deploy_ros2_control_hardware
